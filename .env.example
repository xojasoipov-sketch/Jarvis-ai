# Railway "Variables" bo'limiga yoki lokal ~/.hermes/.env ga qo'ying.
# HECH QACHON haqiqiy qiymatlarni GitHub'ga push qilmang.

# === MAJBURIY ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=          # faqat sizning Telegram raqamli ID'ingiz (masalan 123456789)
OPENROUTER_API_KEY=              # yoki ANTHROPIC_API_KEY / boshqa LLM kaliti

# === XOTIRA (Obsidian vault serverda yaratiladi) ===
# HERMES_HOME Railway'da odatda /data/hermes yoki /opt/data
# Vault avtomatik ${HERMES_HOME}/vault da bo'ladi

# === IXTIYORIY (zaxira / qo'shimcha) ===
GROQ_API_KEY=                    # STT zaxira (bepul)
ELEVENLABS_API_KEY=              # sifatli TTS
GEMINI_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=

# === IXTIYORIY — kuchli vositalar (fine-grained token ishlating) ===
GITHUB_PERSONAL_ACCESS_TOKEN=
RENDER_API_KEY=
SUPABASE_ACCESS_TOKEN=
DATABASE_URL=                    # PostgreSQL connection string
