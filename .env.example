# Pari AI — Environment Variables
# Railway "Variables" bo'limiga yoki lokal .env ga qo'ying
# HECH QACHON haqiqiy qiymatlarni GitHub'ga push qilmang

# === MAJBURIY ===
GEMINI_API_KEY=                  # https://aistudio.google.com/apikey (BEPUL)

# === IXTIYORIY — kelajak uchun ===
OPENROUTER_API_KEY=              # https://openrouter.ai/keys
TELEGRAM_BOT_TOKEN=              # @BotFather dan
TELEGRAM_ALLOWED_USERS=          # Sizning Telegram ID'ingiz (masalan 123456789)
GITHUB_PERSONAL_ACCESS_TOKEN=    # Fine-grained token
RENDER_API_KEY=
SUPABASE_ACCESS_TOKEN=
DATABASE_URL=                    # PostgreSQL connection string
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
