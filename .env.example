# Pari AI / Jarvis-ai — Environment Variables
# Railway → Project → Variables ga qo‘ying
# HECH QACHON haqiqiy qiymatlarni GitHub'ga push qilmang

# === MAJBURIY (kamida bitta LLM kaliti) ===
GEMINI_API_KEY=                  # https://aistudio.google.com/apikey (BEPUL)
# yoki:
GROQ_API_KEY=                    # https://console.groq.com
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# === SUPABASE (ixtiyoriy, lekin tavsiya) ===
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# yoki
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# === TELEGRAM BOT ===
TELEGRAM_BOT_TOKEN=              # @BotFather dan
TELEGRAM_ALLOWED_USERS=          # Telegram user ID (masalan 123456789)

# === AUTH (ixtiyoriy) ===
# AUTH_SECRET=                   # session cookie uchun (random string)
# AUTH_PASSWORD=                 # login paroli

# === LOCAL LLM (Railway Ollama — tavsiya) ===
# Variant A — service nomi:
# OLLAMA_SERVICE=ollama
# OLLAMA_MODEL=llama3.2
# Variant B — to‘liq private URL:
# LOCAL_LLM_URL=http://ollama.railway.internal:11434/v1/chat/completions
# LOCAL_LLM_MODEL=llama3.2
# LOCAL_LLM_KEY=ollama

# === BOSHQA PROVIDERLAR (ixtiyoriy) ===
# CEREBRAS_API_KEY=
# DEEPSEEK_API_KEY=
# MISTRAL_API_KEY=
# MOONSHOT_API_KEY=
# DASHSCOPE_API_KEY=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# === MCP TOOLS ===
# MCP_TOOLS_JSON=[{"name":"mytool","description":"...","url":"https://..."}]

# === OBSIDIAN VAULT ===
# Two backends. If OBSIDIAN_URL is set it wins; otherwise the GitHub-backed
# vault is used (cloud-only, no local server needed).
#
# 1) Real Obsidian — install the "Local REST API" community plugin in Obsidian,
#    copy its API key, and point OBSIDIAN_URL at the plugin's address.
#    The plugin listens on localhost, so a cloud deploy can only reach it through
#    a tunnel (Cloudflare Tunnel, ngrok, Tailscale Funnel…). Use the tunnel's
#    public https URL here, not http://127.0.0.1:27124.
# OBSIDIAN_URL=https://obsidian.your-tunnel.example
# OBSIDIAN_API_KEY=

# 2) GitHub-backed vault (fallback)
# GITHUB_PERSONAL_ACCESS_TOKEN=

# === SENTRY (ixtiyoriy) ===
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_DSN=

# === SITE ===
# SITE_URL=https://your-app.up.railway.app
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app
